+/// ECDSA verification for curve/hash combinations ring does not provide.
+fn verify_ecdsa_prehash(
+    pubkey_inner: &[u8],
+    tbs: &[u8],
+    sig: &[u8],
+    digest_alg: &'static ring::digest::Algorithm,
+    sig_alg_oid: &str,
+) -> Result<()> {
+    let digest = ring::digest::digest(digest_alg, tbs);
+    let fail = |e: String| anyhow!("signature verification failed under {sig_alg_oid}: {e}");
+    match pubkey_inner.len() {
+        // Uncompressed P-256 point: 1 + 32 + 32
+        65 => {
+            use p256::ecdsa::signature::hazmat::PrehashVerifier;
+            use p256::ecdsa::{Signature, VerifyingKey};
+            let key =
+                VerifyingKey::from_sec1_bytes(pubkey_inner).map_err(|e| fail(e.to_string()))?;
+            let signature = Signature::from_der(sig).map_err(|e| fail(e.to_string()))?;
+            key.verify_prehash(digest.as_ref(), &signature)
+                .map_err(|e| fail(e.to_string()))
+        }
+        // Uncompressed P-384 point: 1 + 48 + 48
+        97 => {
+            use p384::ecdsa::signature::hazmat::PrehashVerifier;
+            use p384::ecdsa::{Signature, VerifyingKey};
+            let key =
+                VerifyingKey::from_sec1_bytes(pubkey_inner).map_err(|e| fail(e.to_string()))?;
+            let signature = Signature::from_der(sig).map_err(|e| fail(e.to_string()))?;
+            key.verify_prehash(digest.as_ref(), &signature)
+                .map_err(|e| fail(e.to_string()))
+        }
+        len => bail!("ECDSA key with unexpected uncompressed point length {len}"),
+    }
+}
