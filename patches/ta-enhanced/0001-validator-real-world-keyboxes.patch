+/// Extracts the private scalar from a SEC1 `ECPrivateKey` DER structure:
+/// SEQUENCE { INTEGER 1, OCTET STRING key, [0] curve, [1] publicKey }.
+fn sec1_private_scalar(der: &[u8]) -> Option<Vec<u8>> {
+    fn read_len(der: &[u8], pos: &mut usize) -> Option<usize> {
+        let first = *der.get(*pos)?;
+        *pos += 1;
+        if first & 0x80 == 0 {
+            return Some(first as usize);
+        }
+        let count = (first & 0x7f) as usize;
+        if count == 0 || count > 4 {
+            return None;
         }
+        let mut len = 0usize;
+        for _ in 0..count {
+            len = (len << 8) | *der.get(*pos)? as usize;
+            *pos += 1;
+        }
+        Some(len)
+    }
+
+    let mut pos = 0usize;
+    if *der.get(pos)? != 0x30 {
+        return None;
+    }
+    pos += 1;
+    let _seq_len = read_len(der, &mut pos)?;
+    if *der.get(pos)? != 0x02 {
+        return None;
+    }
+    pos += 1;
+    let version_len = read_len(der, &mut pos)?;
+    pos = pos.checked_add(version_len)?;
+    if *der.get(pos)? != 0x04 {
+        return None;
     }
+    pos += 1;
+    let key_len = read_len(der, &mut pos)?;
+    let end = pos.checked_add(key_len)?;
+    // SEC1 wraps the scalar; strip a leading zero pad if present.
+    let raw = der.get(pos..end)?;
+    Some(raw.to_vec())
 }
 
