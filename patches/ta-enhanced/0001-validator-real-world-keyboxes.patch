+fn try_match_ec(der: &[u8], leaf_spki: &[u8], errors: &mut Vec<String>) -> Option<KeyMatch> {
+    use p256::pkcs8::{DecodePrivateKey as _, EncodePublicKey as _};
+
+    if let Ok(key) = p256::SecretKey::from_pkcs8_der(der) {
+        match key.public_key().to_public_key_der() {
+            Ok(pub_der) => return Some(verdict(pub_der.as_bytes(), leaf_spki)),
+            Err(e) => {
+                errors.push(format!("P-256 public-side DER encode failed: {e}"));
+                return Some(KeyMatch::Mismatched);
+            }
+        }
